                            "$ifNull": [
                              "$$prop.v.en_US",
                              "$$prop.v"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    ],
    "headers": [
      "tr_TR"
    ],
    "result": []
  },
