{
  "name": "api/function/runtime/node/bootstrap",
  "sourceRoot": "packages/api/function/runtime/node/bootstrap",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc --build tsconfig.json"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "devkit/database:bundle"],
      "options": {
        "command": "yarn rollup -c '{projectRoot}/rollup.config.js' --bundleConfigAsCjs"
      }
    }
  }
}
